const jwt = require('jsonwebtoken');
require('dotenv').config();
const jwtSecret = process.env.JWT_SECRET;

function verifyToken(req, res, next) {
  // Priorité au cookie httpOnly, fallback au header Authorization
  let token = req.cookies?.newstud_admin_token || null;
  const bearerToken = req.headers.authorization;

  if (!token && bearerToken && bearerToken.startsWith('Bearer ')) {
    token = bearerToken.replace('Bearer ', '');
  }

  if (!token) {
    return res.status(401).json({ error: 'No token provided' });
  }

  jwt.verify(token, jwtSecret, (err, decoded) => {
    if (err) {
      console.log('Erreur de vérification du token :', err);
      return res.status(401).json({ error: 'Invalid token' });
    }

    req.userData = decoded;
    next(); 
  });
}

module.exports = verifyToken;
